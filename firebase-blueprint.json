      "description": "Daftar administrator sistem"
    },
    "audit_logs": {
      "schema": "AuditLog",
      "description": "Record audit keamanan"
    },
    "themes": {
      "schema": "AppTheme",
      "description": "Koleksi tema visual dinamis"
    },
    "profile_sections": {
      "schema": "ProfileSection",
      "description": "Konten dinamis profil instansi"
    },
    "settings": {
      "schema": "AppConfig",
      "description": "Konfigurasi global aplikasi"
    },
    "banners": {
      "schema": "BannerConfig",
      "description": "Konfigurasi banner dinamis per halaman"
    },
    "personnel": {
      "schema": "Personnel",
      "description": "Database personil dan akun petugas"
    },
    "squads": {
      "schema": "Squad",
      "description": "Koleksi regu operasional"
    },
    "sectors": {
      "schema": "Sector",
      "description": "Daftar sektor dan pos"
    },
    "operational_reports": {
      "schema": "OperationalReport",
      "description": "Dokumentasi laporan tugas internal"
    },
    "river_sensors": {
